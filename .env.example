# .env.example - Copy to .env.local and fill in values

# Supabase (server-side - NEVER prefix with NEXT_PUBLIC_ for secret key)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client-side safe - public, non-sensitive)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth (configured in Supabase Auth dashboard)
# Client ID and Secret are set in Supabase — not needed here directly
# Set the redirect URL in Google Cloud Console: {SUPABASE_URL}/auth/v1/callback

# Slack Webhook (fires on contribution recorded + trophy assigned)
SLACK_WEBHOOK_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Agent Teams (required for claude-bootstrap team workflow)
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
